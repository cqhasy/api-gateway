# =============================================================================
# One API 环境变量示例 — 复制为 .env 后按需修改
# cp .env.example .env
# =============================================================================

# --- 服务基础 ---
PORT=3000
GIN_MODE=release
TZ=Asia/Shanghai

# --- 调试 ---
DEBUG=false
DEBUG_SQL=false

# --- 数据库（必填）---
SQL_DSN=oneapi:123456@tcp(127.0.0.1:3306)/one-api
# LOG_SQL_DSN=
SQL_MAX_IDLE_CONNS=100
SQL_MAX_OPEN_CONNS=1000
SQL_MAX_LIFETIME=60

# --- 会话与节点 ---
SESSION_SECRET=change-me-to-a-long-random-string
NODE_TYPE=master
# FRONTEND_BASE_URL=

# --- Redis ---
REDIS_CONN_STRING=redis://127.0.0.1:6379
# REDIS_PASSWORD=
# REDIS_MASTER_NAME=

# --- 缓存 ---
MEMORY_CACHE_ENABLED=true
SYNC_FREQUENCY=600

# --- 批量写库 ---
BATCH_UPDATE_ENABLED=false
BATCH_UPDATE_INTERVAL=5

# --- 渠道自动任务（分钟）---
# CHANNEL_TEST_FREQUENCY=1440
# POLLING_INTERVAL=

# --- 限流 ---
GLOBAL_API_RATE_LIMIT=480
GLOBAL_WEB_RATE_LIMIT=240

# --- 代理 ---
RELAY_TIMEOUT=0
# RELAY_PROXY=
# USER_CONTENT_REQUEST_PROXY=
USER_CONTENT_REQUEST_TIMEOUT=30
# HTTP_PROXY=
# HTTPS_PROXY=

# --- Tiktoken 离线 ---
# TIKTOKEN_CACHE_DIR=
# DATA_GYM_CACHE_DIR=

# --- Gemini / 主题 ---
GEMINI_SAFETY_SETTING=BLOCK_NONE
GEMINI_VERSION=v1
THEME=default

# --- 监控 ---
ENABLE_METRIC=false
METRIC_QUEUE_SIZE=10
METRIC_SUCCESS_RATE_THRESHOLD=0.8
METRIC_SUCCESS_CHAN_SIZE=1024
METRIC_FAIL_CHAN_SIZE=128

# --- 首次启动 ---
# INITIAL_ROOT_TOKEN=
# INITIAL_ROOT_ACCESS_TOKEN=

# --- 其他 ---
ENFORCE_INCLUDE_USAGE=false
ONLY_ONE_LOG_FILE=false
